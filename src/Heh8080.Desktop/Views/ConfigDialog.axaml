<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Heh8080.Views.ConfigDialog"
        Title="FJM-3A Configuration"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0A140A"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="BorderOnly">

    <Window.Styles>
        <Style Selector="Button:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3A2A"/>
            <Setter Property="BorderBrush" Value="#33FF33"/>
            <Setter Property="Foreground" Value="#33FF33"/>
        </Style>
        <Style Selector="Button:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A4A3A"/>
            <Setter Property="BorderBrush" Value="#33FF33"/>
            <Setter Property="Foreground" Value="#33FF33"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#33FF33" BorderThickness="2" CornerRadius="4">
        <StackPanel Margin="24" Spacing="8">
            <!-- Title Bar -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="X" Click="Close_Click"
                        Background="Transparent" Foreground="#33FF33"
                        BorderThickness="0" FontFamily="Consolas,monospace"
                        Padding="8,4" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="FJM-3A Configuration"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#33FF33"
                           FontFamily="Consolas,monospace"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Rectangle Height="1" Fill="#33FF33" Opacity="0.3"/>

            <!-- Disk Drives Section -->
            <TextBlock Text="DISK DRIVES" FontWeight="Bold" Foreground="#33FF33"
                       FontFamily="Consolas,monospace" FontSize="12"/>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="40,150,72,72"
                  RowSpacing="4" Margin="8,0,0,0" HorizontalAlignment="Left">
                <Grid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="#1A2A1A"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="BorderBrush" Value="#33FF33"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="CornerRadius" Value="2"/>
                    </Style>
                    <Style Selector="CheckBox">
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Styles>

                <!-- Drive A: -->
                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="DriveAPrefix" Text="A:"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriveALabel" Text="(empty)"
                           Opacity="0.6" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="MountA" Content="Mount" Click="MountA_Click" Margin="2,0"/>
                <Button Grid.Row="0" Grid.Column="3" x:Name="EjectA" Content="Eject" Click="UnmountA_Click" Margin="2,0"/>

                <!-- Drive B: -->
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="DriveBPrefix" Text="B:"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DriveBLabel" Text="(empty)"
                           Opacity="0.6" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="MountB" Content="Mount" Click="MountB_Click" Margin="2,0"/>
                <Button Grid.Row="1" Grid.Column="3" x:Name="EjectB" Content="Eject" Click="UnmountB_Click" Margin="2,0"/>

                <!-- Drive C: -->
                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="DriveCPrefix" Text="C:"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DriveCLabel" Text="(empty)"
                           Opacity="0.6" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="2" Grid.Column="2" x:Name="MountC" Content="Mount" Click="MountC_Click" Margin="2,0"/>
                <Button Grid.Row="2" Grid.Column="3" x:Name="EjectC" Content="Eject" Click="UnmountC_Click" Margin="2,0"/>

                <!-- Drive D: -->
                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="DriveDPrefix" Text="D:"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DriveDLabel" Text="(empty)"
                           Opacity="0.6" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="3" Grid.Column="2" x:Name="MountD" Content="Mount" Click="MountD_Click" Margin="2,0"/>
                <Button Grid.Row="3" Grid.Column="3" x:Name="EjectD" Content="Eject" Click="UnmountD_Click" Margin="2,0"/>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="HardDiskInstalled" Content="HD" Click="HardDisk_Click"/>
                    <TextBlock x:Name="HardDiskLabel" Text="(empty)"
                               Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Row="4" Grid.Column="2" x:Name="MountHardDiskButton" Content="Mount" Click="MountHardDisk_Click" Margin="2,0"/>
                <Button Grid.Row="4" Grid.Column="3" x:Name="EjectHardDiskButton" Content="Eject" Click="EjectHardDisk_Click" Margin="2,0"/>
            </Grid>

            <Rectangle Height="1" Fill="#33FF33" Opacity="0.3" Margin="0,8,0,0"/>

            <!-- System Section -->
            <TextBlock Text="SYSTEM" FontWeight="Bold" Foreground="#33FF33"
                       FontFamily="Consolas,monospace" FontSize="12"/>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="80,*" Margin="8,0,0,0">
                <Grid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="RadioButton">
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                    <Style Selector="RadioButton:checked:not(:disabled) /template/ Ellipse#CheckOuterEllipse">
                        <Setter Property="Fill" Value="#33FF33"/>
                        <Setter Property="Stroke" Value="#33FF33"/>
                    </Style>
                    <Style Selector="RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Foreground" Value="#33FF33"/>
                    </Style>
                    <Style Selector="RadioButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Foreground" Value="#33FF33"/>
                    </Style>
                    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
                        <Setter Property="Fill" Value="#0A140A"/>
                    </Style>
                    <Style Selector="TextBox">
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="Background" Value="#1A2A1A"/>
                        <Setter Property="BorderBrush" Value="#33FF33"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                    <Style Selector="CheckBox">
                        <Setter Property="FontFamily" Value="Consolas,monospace"/>
                        <Setter Property="Foreground" Value="#33FF33"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </Grid.Styles>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine:"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="MachineCpm" Content="CP/M" GroupName="Machine"
                                 IsChecked="True" Click="Machine_Click"/>
                    <RadioButton x:Name="MachineCp500" Content="CP-500" GroupName="Machine"
                                 Click="Machine_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU:" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                    <RadioButton x:Name="CpuZ80" Content="Z80" GroupName="CpuType"
                                 IsChecked="True" Click="CpuType_Click"/>
                    <RadioButton x:Name="Cpu8080" Content="8080" GroupName="CpuType"
                                 Click="CpuType_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Speed:" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                    <RadioButton x:Name="Speed1x" Content="1x" GroupName="Speed"
                                 IsChecked="True" Click="Speed_Click"/>
                    <RadioButton x:Name="Speed2x" Content="2x" GroupName="Speed"
                                 Click="Speed_Click"/>
                    <RadioButton x:Name="Speed4x" Content="4x" GroupName="Speed"
                                 Click="Speed_Click"/>
                    <RadioButton x:Name="SpeedMax" Content="Max" GroupName="Speed"
                                 Click="Speed_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="RS-232:" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <RadioButton x:Name="Rs232Off" Content="Off" GroupName="Rs232"
                                 IsChecked="True" Click="Rs232_Click"/>
                    <RadioButton x:Name="Rs232Tcp" Content="TCP" GroupName="Rs232" Click="Rs232_Click"/>
                    <RadioButton x:Name="Rs232Com" Content="COM" GroupName="Rs232" Click="Rs232_Click"/>
                    <RadioButton x:Name="Rs232Hayes" Content="Hayes" GroupName="Rs232" Click="Rs232_Click"/>
                    <Button x:Name="Rs232Apply" Content="Apply" Click="Rs232Apply_Click"
                            Background="#1A2A1A" Foreground="#33FF33"
                            BorderBrush="#33FF33" BorderThickness="1"
                            FontFamily="Consolas,monospace" FontSize="11"
                            Padding="12,6" CornerRadius="2"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Spacing="8">
                    <StackPanel x:Name="Rs232TcpFields" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="Host" VerticalAlignment="Center"/>
                        <TextBox x:Name="Rs232Host" Width="120" Watermark="127.0.0.1"/>
                        <TextBlock Text="Port" VerticalAlignment="Center"/>
                        <TextBox x:Name="Rs232Port" Width="64" Watermark="2323"/>
                        <CheckBox x:Name="Rs232Listen" Content="Listen" Click="Rs232Listen_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Rs232ComFields" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="Port" VerticalAlignment="Center"/>
                        <TextBox x:Name="Rs232ComName" Width="120" Watermark="COM3"/>
                    </StackPanel>
                    <StackPanel x:Name="Rs232HayesFields" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="Port" VerticalAlignment="Center"/>
                        <TextBox x:Name="Rs232HayesPort" Width="64" Watermark="2323"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Action:" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Content="Reset CPU" Click="Reset_Click"
                            Background="#1A2A1A" Foreground="#33FF33"
                            BorderBrush="#33FF33" BorderThickness="1"
                            FontFamily="Consolas,monospace" FontSize="11"
                            Padding="12,6" CornerRadius="2"/>
                    <TextBlock x:Name="ResetHint" Text="Warm boot from A:" Foreground="#33FF33"
                               FontFamily="Consolas,monospace" FontSize="11"
                               Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="#33FF33" Opacity="0.3" Margin="0,8,0,0"/>

            <!-- Status -->
            <TextBlock x:Name="StatusLabel" Text="" Foreground="#33FF33"
                       FontFamily="Consolas,monospace" FontSize="11"
                       MinHeight="16"/>

            <!-- About -->
            <StackPanel Opacity="0.5" Margin="0,8,0,0">
                <TextBlock Text="heh8080 - 8080/Z80 Emulator"
                           Foreground="#33FF33" FontFamily="Consolas,monospace"
                           FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Text="github.com/fjzeit/heh8080"
                           Foreground="#33FF33" FontFamily="Consolas,monospace"
                           FontSize="10" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
